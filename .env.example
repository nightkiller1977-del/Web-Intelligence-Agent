# Web Intelligence Agent Configuration
# Copy to .env and set your own values

# Deployment Modes
DEPLOYMENT_MODE=local
STORAGE_BACKEND=local

# Server
HOST=127.0.0.1
PORT=8080

# Authentication (auto-generated in local mode if not provided)
WEB_INTELLIGENCE_AUTH_TOKEN=your_secure_token_here

# External APIs
# All external model inference egresses through AI-OpenRouter. Do not set a
# direct provider key (for example OPENAI_API_KEY): ambient external-provider
# credentials are masked inside each request context.
AI_OPENROUTER_ENABLED=false
AI_OPENROUTER_BASE_URL=https://ai-openrouter.example
AI_OPENROUTER_API_KEY=replace-with-shared-gateway-credential
# OpenAI-compatible model the gateway serves when a request selects no model.
AI_OPENROUTER_DEFAULT_MODEL=gpt-4o-mini
# OpenAI embedding model name used when embeddings run through the gateway.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TAVILY_API_KEY=your_tavily_api_key

# Local model used when the gateway is disabled and no model is requested.
# Inference stays local; no external egress occurs. OLLAMA_BASE_URL must be a
# loopback/private address; a public host is rejected as a local endpoint.
LOCAL_DEFAULT_MODEL=llama3
# Local embedding model used for local inference.
LOCAL_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Redis (only needed if STORAGE_BACKEND=redis)
REDIS_URL=redis://localhost:6379/0
# Fail closed when redis is selected but unreachable instead of silently
# falling back to process-local memory. Enable for durable deployments.
REDIS_REQUIRED=false
# Lease TTL for concurrency slots and operation liveness (seconds)
STALE_RECONCILE_INTERVAL_SECONDS=60
CONCURRENCY_LEASE_TTL_SECONDS=3600

# Concurrency and Resource Limits
MAX_CONCURRENT_OPS=3
MAX_MEMORY_MB=512
DEFAULT_OPERATION_COST_RESERVE_USD=0.25
DAILY_SPEND_LIMIT_USD=50.0

# Local input ingestion (os.pathsep-separated filesystem roots).
# Document/repository inputs may only be read from these roots.
# Empty disables local file inputs entirely.
LOCAL_INPUT_ROOTS=

# CORS Configuration (comma-separated list)
# Example: http://localhost:3000,http://localhost:5000
CORS_ORIGINS=

# Documentation Access (local mode only)
ALLOW_UNAUTHENTICATED_DOCS=false

# Optional Brain Memory evidence context (all-or-nothing; disabled unless enabled)
# Keep BRAIN_MEMORY_CONTEXT_ENABLED=false unless the receiving model and policy
# permit the bounded, provenance-labelled historical evidence context.
BRAIN_MEMORY_ENABLED=false
BRAIN_MEMORY_CONTEXT_ENABLED=false
BRAIN_MEMORY_URL=
BRAIN_MEMORY_KEY_ID=
BRAIN_MEMORY_SECRET=
